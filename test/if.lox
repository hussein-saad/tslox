if (true) print "then";
if (false) print "never";

if (1) {
  print "truthy";
} else {
  print "not reached";
}

if (0) {
  print "zero is truthy";
} else {
  print "zero is falsey";
}

var value = 7;
if (value > 5) {
  print "greater than five";
} else {
  print "not greater than five";
}

if (value < 5) {
  print "less than five";
} else if (value == 7) {
  print "exactly seven";
} else {
  print "something else";
}
